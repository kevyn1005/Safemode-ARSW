<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.safemode</groupId>
    <artifactId>safemode-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Safemode Parent</name>
    <description>Monorepo padre del sistema Safemode</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sonar.coverage.exclusions>
            **/AlertEngineRunner.java,
            **/AlertLatencyBenchmark.java,
            **/DetectionBenchmark.java,
            **/GatewayRunner.java,
            **/ObjectPresenceTrackerTest.java,
            **/FrameCapturerTest.java,
            **/ScreenCaptureTest.java,
            **/VisionDetectionTest.java,
            **/TelegramChatIds.java,
            **/TelegramTestMessage.java
            **/NvidiaCropCheck.java,
            **/MousePositionFinder.java,
        </sonar.coverage.exclusions>
    </properties>

    <modules>
        <module>camera-feed-service</module>
        <module>vision-detection-service</module>
        <module>object-presence-tracker</module>
        <module>alert-engine</module>
        <module>realtime-gateway</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <configuration>
                    <excludes>
                        <exclude>**/AlertEngineRunner*.class</exclude>
                        <exclude>**/AlertLatencyBenchmark*.class</exclude>
                        <exclude>**/DetectionBenchmark*.class</exclude>
                        <exclude>**/GatewayRunner*.class</exclude>
                        <exclude>**/ObjectPresenceTrackerTest*.class</exclude>
                        <exclude>**/FrameCapturerTest*.class</exclude>
                        <exclude>**/ScreenCaptureTest*.class</exclude>
                        <exclude>**/VisionDetectionTest*.class</exclude>
                        <exclude>**/TelegramChatIds*.class</exclude>
                        <exclude>**/TelegramTestMessage*.class</exclude>
                        <exclude>**/NvidiaCropCheck*.class</exclude>
                        <exclude>**/MousePositionFinder*.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Persistencia y consistencia (ADR 0005): tres servicios nuevos que se SUMAN al reactor solo si sus carpetas existen.
            Por que asi y no en <modules>: los Dockerfiles de camera-feed-service, vision-detection-service y realtime-gateway
            copian unicamente los cinco modulos de arriba; si el pom padre exigiera siempre los nuevos, esas tres imagenes
            (que ya funcionan) dejarian de construirse con "Child module ... does not exist". En el repo completo (y en los
            Dockerfiles de los servicios nuevos, que copian service-common) el perfil se activa solo.
        -->
        <profile>
            <id>persistencia</id>
            <activation>
                <file>
                    <exists>${basedir}/service-common/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>service-common</module>
                <module>access-service</module>
                <module>collaboration-service</module>
            </modules>
        </profile>
    </profiles>
</project>
