<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.safemode</groupId>
        <artifactId>safemode-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>access-service</artifactId>
    <packaging>jar</packaging>
    <name>access-service</name>
    <description>Gestion de acceso: operadores, puestos y membresias en PostgreSQL. Es la AUTORIDAD de permisos (ADR 0005)</description>

    <dependencies>
        <dependency>
            <groupId>com.safemode</groupId>
            <artifactId>service-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>
        <!-- pool de conexiones: una por peticion seria lento y, con PostgreSQL caido, el timeout debe ser corto y explicito -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <!-- HikariCP registra con slf4j; sin proveedor imprime un aviso al arrancar (igual que el gateway) -->
        <!-- API 2.x explicita: HikariCP / los drivers traen la 1.7, que no encuentra el proveedor nop 2.x y avisa igual -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
