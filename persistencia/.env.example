# Opcional: los valores de laboratorio funcionan sin este archivo. Para cambiarlos:  cp persistencia/.env.example .env
# (PowerShell: Copy-Item persistencia\.env.example .env). No suba un .env con claves reales: esta en .gitignore.
POSTGRES_PASSWORD=lab-postgres
LAB_ADMIN_KEY=lab-admin
GRAFANA_PASSWORD=lab-grafana
# puertos publicados solo en 127.0.0.1
POSTGRES_PORT=5433
CONSOLE_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# solucion (por defecto) | base (los defectos del punto de partida, para repetir la medicion del "antes")
DECISIONS_MODE=solucion
