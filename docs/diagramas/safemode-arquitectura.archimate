    <element xsi:type="archimate:BusinessActor" name="Personal de seguridad" id="id-82b1c49711fb4f38abc96c76712cd4c4"/>
      <element xsi:type="archimate:BusinessActor" name="Administrador del puesto" id="id-ca0f91438b674c0a954bca6d77d93ad4">
      <documentation>Quien puede configurar zonas, nombres de cámaras y permisos del puesto (SAFEMODE_ADMIN_EMAILS la primera vez; después manda PostgreSQL).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Equipo de desarrollo" id="id-d50454004eed43719816f8f4911dbf07"/>
  </folder>
  <folder name="Application" id="id-f2ee85b61b75490d8d47c550e1740805" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Software de cámaras (VMS) · externo, graba el video" id="id-a8eb5d7802814c8eaa4ede43a0000559"/>
    <element xsi:type="archimate:ApplicationComponent" name="Security Dashboard (panel web)" id="id-1cab72f433b94c38b61b47d5f9251d09"/>
