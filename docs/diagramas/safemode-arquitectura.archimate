    <element xsi:type="archimate:ApplicationComponent" name="AlertGateway" id="id-452759853357409da2adb80f3f267657">
      <documentation>WebSocket :8090 (Java-WebSocket): snapshot, alert y update; revisa Origin y sesión.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="NotificationService" id="id-ee35c63a873243999ff0fdb2c9d3abbc">
      <documentation>Avisos de texto en hilos aparte; solo severidad alta y media.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GatewayRunner" id="id-dc7554c3b0d7439da194249f8bf7f240">
      <documentation>Arma y arranca todo el gateway a partir de las variables de entorno.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="DashboardHttpServer" id="id-3a5d1238902749c69e32cee5b6391dc2">
      <documentation>HTTP :8080: página, fotos, /report, /cameras, /tracker/*, /puesto, /auth/*. 32 hilos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AuthService" id="id-e34a68fb172844ee855512a3273672ee">
      <documentation>Verifica el ID token de Google, lista blanca de correos y sesiones de 12 h.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="TrackerControl" id="id-c10ec80334cf4d8bb8cfb195ea809af0">
      <documentation>Estado, inicio y parada del tracker.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="TrackerProcess" id="id-e01b147668a24b9b97e7e259f09c0dc8"/>
    <element xsi:type="archimate:ApplicationInterface" name="TokenVerifier" id="id-c3f514f7e53a4b3aae0975538fd65469">
      <documentation>Verifica un ID token y devuelve el usuario.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GoogleTokenVerifier" id="id-ec17fb8c94dc4e8b8c3f1f0049d00791"/>
    <element xsi:type="archimate:ApplicationInterface" name="SessionStore" id="id-8714118c498444c9ada28c26c6493d40">
