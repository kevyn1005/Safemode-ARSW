    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GoogleTokenVerifier" id="id-9d071fbe864344ffaf0aa072879665a3"/>
    <element xsi:type="archimate:ApplicationInterface" name="SessionStore" id="id-81b23007e84a46c4b288eb5e6ff0e08a">
