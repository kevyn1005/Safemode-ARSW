    <element xsi:type="archimate:ApplicationComponent" name="AlertGateway" id="id-71c5623e84ec40298ad15a9937fd77e8">
      <documentation>WebSocket :8090 (Java-WebSocket): snapshot, alert y update; revisa Origin y sesión.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="NotificationService" id="id-b560a3bb796b44e8b59091f497215c01">
      <documentation>Avisos de texto en hilos aparte; solo severidad alta y media.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GatewayRunner" id="id-7c4ede18d251441ebac11a9305c6bcdf">
      <documentation>Arma y arranca todo el gateway a partir de las variables de entorno.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="DashboardHttpServer" id="id-ba68e8e2f9b74e04a8c34f9fd913113b">
      <documentation>HTTP :8080: página, fotos, /report, /cameras, /tracker/*, /puesto, /auth/*. 32 hilos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AuthService" id="id-bf350f71f46e4fb690246be649b2796a">
      <documentation>Verifica el ID token de Google, lista blanca de correos y sesiones de 12 h.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="TrackerControl" id="id-629da835348d4a33851dd5d0bb8238c0">
      <documentation>Estado, inicio y parada del tracker.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="TrackerProcess" id="id-1b1fa5db33eb44898251ac4eec240fb1"/>
    <element xsi:type="archimate:ApplicationInterface" name="TokenVerifier" id="id-c9fba57073df4f55bb497fcb2de11be3">
      <documentation>Verifica un ID token y devuelve el usuario.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GoogleTokenVerifier" id="id-2308828607a94055afadcb0a6a46e1b4"/>
    <element xsi:type="archimate:ApplicationInterface" name="SessionStore" id="id-51961b80252f4b25b7d1de21b2281b5a">
      <documentation>Guarda la sesión por la huella SHA-256 de la cookie.</documentation>
    </element>
