      </child>
      <child xsi:type="archimate:DiagramObject" id="id-66105d2e2a9641ad87dc674098f3fab4" targetConnections="id-f8dcf7b79aed428a9eb95b4a5a027636" archimateElement="id-65b5fbcf34844883be97a8d5b8e11106">
        <bounds x="330" y="500" width="200" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-a8f907e8549d432496fbc4efeb8bf3b0" targetConnections="id-02b50598af0246458642c24364c629c4" archimateElement="id-103926b482bb438f87c0dcfb44389d4c">
