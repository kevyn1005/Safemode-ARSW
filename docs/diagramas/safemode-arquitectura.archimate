    <element xsi:type="archimate:ApplicationComponent" name="access-service" id="id-22a8436132da4afc9f70796516de4a97">
      <documentation>Autoridad de permisos: operadores, membresías y auditoría (PostgreSQL).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AccessRepository (permisos)" id="id-b418c59b4e604817bb49cc3e9a613b7e"/>
    <element xsi:type="archimate:ApplicationComponent" name="Prometheus" id="id-9b44014fb7ca477fb8f11ef191b12030"/>
    <element xsi:type="archimate:ApplicationComponent" name="Grafana" id="id-11f294d7e6b24d09842387e5694c79ea"/>
    <element xsi:type="archimate:ApplicationComponent" name="k6" id="id-e92d43c44652449f80c9b209786a7527"/>
    <element xsi:type="archimate:ApplicationInterface" name="FrameSource" id="id-f06f100b686d4f15a028428039601961">
      <documentation>Fuente de fotogramas de una cámara: getLatestFrame(n).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BrowserFrameSource" id="id-775d62ba7c6741798bb8ac4161b25487">
      <documentation>Servidor WebSocket :8091; mensajes binarios (1 byte de cámara + JPEG); valida Origin.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="FrameCapturer" id="id-2f0a5ae02e5b491aa8258b4f5b439f9c">
      <documentation>Captura de pantalla con java.awt.Robot (la fuente de siempre).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ObjectDetector" id="id-747ea6c627d348c8a6c182787a2d59ae">
      <documentation>YOLOv8 en ONNX Runtime: personas, mochilas, bolsos y maletas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PoseEstimator" id="id-18ab3ed53bc64b74b7c6891d8e5b8b06">
      <documentation>YOLOv8-pose: 17 puntos del cuerpo sobre el recorte del dueño.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ObjectTracker" id="id-f2d74163765a49049375534930e2d5eb">
      <documentation>Máquina de estados NEW → AT_REST (3 s quieto) → REMOVED; dueño probable y tipo de retiro.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="TrackedObject" id="id-83867e3da31f49caaad8d1bccb51c53f"/>
    <element xsi:type="archimate:ApplicationComponent" name="TrackedPerson" id="id-695bcc2d62744517a030face85ce2ea3"/>
    <element xsi:type="archimate:ApplicationComponent" name="PersonDescriber" id="id-678a40b769974a56880e649d503a10b7">
      <documentation>Color dominante del torso (con pose o franja fija).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PersonAppearance" id="id-dc5401730fa242fb9a91ab63a7461fd6">
      <documentation>Color medio del torso: evita heredar el id de otra persona.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="RegionFingerprint" id="id-83285fb41cb24110bc6728976d2c7b9d">
      <documentation>Huella 24×24 de brillo para verificar un retiro por imagen.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="OwnerVisionDescriber" id="id-5ee332e7df864ca9826ba68c5c0c4bb4">
      <documentation>Descripción del dueño por IA (opcional, en segundo plano).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="NvidiaOwnerVisionDescriber" id="id-9da2a8377fdb491ab2925c1bf943ae35"/>
    <element xsi:type="archimate:ApplicationComponent" name="ArmsCropper" id="id-4809651c35034b6c92ded2646f7be0fe">
      <documentation>Recorta los antebrazos (sin cara) para revisar tatuajes.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="RemovalKind (enum)&#10;BY_OWNER&#10;BY_OTHER&#10;OWNER_AND_OTHER_NEAR&#10;NO_ONE_NEAR&#10;OWNER_UNKNOWN" id="id-84f698b2a9a44f618b7f166afda65a09"/>
    <element xsi:type="archimate:ApplicationComponent" name="PresenceEventStore" id="id-8aecdcb55d484d5f99ec22b3b7452ff2">
      <documentation>Tabla object_presence_event (H2 o PostgreSQL): registrar, retirar, buscar por id (por bloques), reporte.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ReconnectingConnection" id="id-0b9c00ea6faf452bb629976f3b62180e">
      <documentation>Valida la conexión antes de cada operación y la reabre sola si la base se reinició.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="SqlDialect (enum)&#10;H2 · POSTGRESQL" id="id-5051592f82d9415d876b06e177eace4d"/>
    <element xsi:type="archimate:DataObject" name="StoredEvent (record)" id="id-aeb593d090d646d2af73bbda9f80ad06"/>
    <element xsi:type="archimate:ApplicationComponent" name="AlertStore" id="id-5dbd6a5c123a45f494c0a00e92003d22">
      <documentation>Tabla alert; una alerta por evento (UNIQUE; SQLState 23505 = ya existe).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AlertEngine" id="id-654ecb70b3a44d8186bafcb94fe6ba38">
      <documentation>Lee los retiros nuevos, aplica las reglas y avisa a los oyentes.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AlertRules" id="id-cec9501cf5934359ae7dccfe59682a0c">
      <documentation>RemovalKind → tipo y severidad de la alerta.</documentation>
    </element>
