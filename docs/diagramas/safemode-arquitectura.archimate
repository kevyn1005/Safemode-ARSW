    <element xsi:type="archimate:ApplicationComponent" name="Software de cámaras (VMS) · externo, graba el video" id="id-a8eb5d7802814c8eaa4ede43a0000559"/>
    <element xsi:type="archimate:ApplicationComponent" name="Security Dashboard (panel web)" id="id-1cab72f433b94c38b61b47d5f9251d09"/>
