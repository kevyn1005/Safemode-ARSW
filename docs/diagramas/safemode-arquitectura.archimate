    <element xsi:type="archimate:ApplicationComponent" name="access-service" id="id-81e20cc26ae849b4b3fb137643097a91">
      <documentation>Autoridad de permisos: operadores, membresías y auditoría (PostgreSQL).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AccessRepository (permisos)" id="id-5231ab1a52f24dc889cec538223203e9"/>
    <element xsi:type="archimate:ApplicationComponent" name="Prometheus" id="id-2f2a950a9d5b491783cea8de0da7dbf8"/>
    <element xsi:type="archimate:ApplicationComponent" name="Grafana" id="id-0a4441b28fda4270ac6c615b4f91999e"/>
    <element xsi:type="archimate:ApplicationComponent" name="k6" id="id-af84b6fcddf1479091ed9923111c3eee"/>
    <element xsi:type="archimate:ApplicationInterface" name="FrameSource" id="id-433a7852a83c4775af0abcd4d9e43cfc">
      <documentation>Fuente de fotogramas de una cámara: getLatestFrame(n).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BrowserFrameSource" id="id-5ecc12fb08e84703965c099d44388ff4">
      <documentation>Servidor WebSocket :8091; mensajes binarios (1 byte de cámara + JPEG); valida Origin.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="FrameCapturer" id="id-367cf9d49656425e8eb227eb71984d51">
      <documentation>Captura de pantalla con java.awt.Robot (la fuente de siempre).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ObjectDetector" id="id-a15e6d8b7f2144b097673bd0e15ef498">
      <documentation>YOLOv8 en ONNX Runtime: personas, mochilas, bolsos y maletas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PoseEstimator" id="id-32d7eb40104b4c75bb91a47b48dc7679">
      <documentation>YOLOv8-pose: 17 puntos del cuerpo sobre el recorte del dueño.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ObjectTracker" id="id-b54bdb0f4cc94b2aa58cd7c817b8aebe">
      <documentation>Máquina de estados NEW → AT_REST (3 s quieto) → REMOVED; dueño probable y tipo de retiro.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="TrackedObject" id="id-c7457d2be8d547248a6cf75185428e9a"/>
    <element xsi:type="archimate:ApplicationComponent" name="TrackedPerson" id="id-22c9c3ba426a4d95ab5ad508671ef9c6"/>
    <element xsi:type="archimate:ApplicationComponent" name="PersonDescriber" id="id-d60a9c56092f4c36b42d41e351e51822">
      <documentation>Color dominante del torso (con pose o franja fija).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PersonAppearance" id="id-5c84fe213650444281623c9e50e34dd3">
      <documentation>Color medio del torso: evita heredar el id de otra persona.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="RegionFingerprint" id="id-3b03b95ce0dd4a0f862d8a12bfcb769a">
      <documentation>Huella 24×24 de brillo para verificar un retiro por imagen.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="OwnerVisionDescriber" id="id-837ea7d76206475c988d89bf9764bc5f">
      <documentation>Descripción del dueño por IA (opcional, en segundo plano).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="NvidiaOwnerVisionDescriber" id="id-a298c4a938d14bd2a81d7dc6f7589cdc"/>
    <element xsi:type="archimate:ApplicationComponent" name="ArmsCropper" id="id-6d54269f136f4a4385b28d462926f660">
      <documentation>Recorta los antebrazos (sin cara) para revisar tatuajes.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="RemovalKind (enum)&#10;BY_OWNER&#10;BY_OTHER&#10;OWNER_AND_OTHER_NEAR&#10;NO_ONE_NEAR&#10;OWNER_UNKNOWN" id="id-7b917e0b717744ab85f0ac15952a194e"/>
    <element xsi:type="archimate:ApplicationComponent" name="PresenceEventStore" id="id-5d6805773b524bc58162498ffb448254">
      <documentation>Tabla object_presence_event (H2 o PostgreSQL): registrar, retirar, buscar por id (por bloques), reporte.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ReconnectingConnection" id="id-4b2aa918e7584d40ac161cab9b33d945">
      <documentation>Valida la conexión antes de cada operación y la reabre sola si la base se reinició.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="SqlDialect (enum)&#10;H2 · POSTGRESQL" id="id-e3e197aca88a414388d9b52aa5aa357c"/>
    <element xsi:type="archimate:DataObject" name="StoredEvent (record)" id="id-10d17f1d12a1481ab65f4b51b944e691"/>
    <element xsi:type="archimate:ApplicationComponent" name="AlertStore" id="id-cfbfaa496cc64abcba2fe34ed201f5f3">
      <documentation>Tabla alert; una alerta por evento (UNIQUE; SQLState 23505 = ya existe).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AlertEngine" id="id-6b81c7383de6400dac4d57a9052ecb4a">
      <documentation>Lee los retiros nuevos, aplica las reglas y avisa a los oyentes.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AlertRules" id="id-f9826d3c1573495bad5b6b473c7611c5">
      <documentation>RemovalKind → tipo y severidad de la alerta.</documentation>
    </element>
