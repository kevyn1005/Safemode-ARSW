    <element xsi:type="archimate:ApplicationComponent" name="access-service" id="id-ef1fb7c226a24218a6334d856a9e44a5">
      <documentation>Autoridad de permisos: operadores, membresías y auditoría (PostgreSQL).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AccessRepository (permisos)" id="id-79af29eae14940faa80fb52b2ed782e8"/>
    <element xsi:type="archimate:ApplicationComponent" name="Prometheus" id="id-9ddbdb051f2a45aba8a1170f60b97a18"/>
    <element xsi:type="archimate:ApplicationComponent" name="Grafana" id="id-f61349b9fe0743f9b850bd170cf3da0c"/>
    <element xsi:type="archimate:ApplicationComponent" name="k6" id="id-6726947e656247c19eb89ed0f8087b0a"/>
    <element xsi:type="archimate:ApplicationInterface" name="FrameSource" id="id-9a0ac7747c46428999db184aa2184427">
      <documentation>Fuente de fotogramas de una cámara: getLatestFrame(n).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BrowserFrameSource" id="id-77e1a080bea7463c852579e2c851be0b">
      <documentation>Servidor WebSocket :8091; mensajes binarios (1 byte de cámara + JPEG); valida Origin.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="FrameCapturer" id="id-1c5129fa5d804ee98602df2fc2ce82ab">
      <documentation>Captura de pantalla con java.awt.Robot (la fuente de siempre).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ObjectDetector" id="id-129f02565dc140e89f2d5fb974f925a4">
      <documentation>YOLOv8 en ONNX Runtime: personas, mochilas, bolsos y maletas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PoseEstimator" id="id-e1b0bcab333b44d2bcff706eaf036001">
      <documentation>YOLOv8-pose: 17 puntos del cuerpo sobre el recorte del dueño.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ObjectTracker" id="id-ee69a288580e416ea4cd3f51af8e1971">
      <documentation>Máquina de estados NEW → AT_REST (3 s quieto) → REMOVED; dueño probable y tipo de retiro.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="TrackedObject" id="id-1623b4ab4f954e52a5527087eb00d14b"/>
    <element xsi:type="archimate:ApplicationComponent" name="TrackedPerson" id="id-b70d18b2225a492f8714ecdc2f74e888"/>
    <element xsi:type="archimate:ApplicationComponent" name="PersonDescriber" id="id-8684d59bedec4b94a8ba95ab47f6099a">
      <documentation>Color dominante del torso (con pose o franja fija).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PersonAppearance" id="id-8537797ed08645a69045f9f7918a2d26">
      <documentation>Color medio del torso: evita heredar el id de otra persona.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="RegionFingerprint" id="id-f5e4ad6a28df4beaa21cba1d7138f8c3">
      <documentation>Huella 24×24 de brillo para verificar un retiro por imagen.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="OwnerVisionDescriber" id="id-3209e9984cd74d74a425f6d51b7efe33">
      <documentation>Descripción del dueño por IA (opcional, en segundo plano).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="NvidiaOwnerVisionDescriber" id="id-0d4f956b9f514f85ad108664baf09e00"/>
    <element xsi:type="archimate:ApplicationComponent" name="ArmsCropper" id="id-dfdb06fe58114371b3b195dc12a09507">
      <documentation>Recorta los antebrazos (sin cara) para revisar tatuajes.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="RemovalKind (enum)&#10;BY_OWNER&#10;BY_OTHER&#10;OWNER_AND_OTHER_NEAR&#10;NO_ONE_NEAR&#10;OWNER_UNKNOWN" id="id-30ec263407a34abea21441663c6674c6"/>
    <element xsi:type="archimate:ApplicationComponent" name="PresenceEventStore" id="id-8d1c25d1be01489681e9118b0dc21f6f">
      <documentation>Tabla object_presence_event (H2 o PostgreSQL): registrar, retirar, buscar por id (por bloques), reporte.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ReconnectingConnection" id="id-f133f7d4031b49cd861c394dede4b7b1">
      <documentation>Valida la conexión antes de cada operación y la reabre sola si la base se reinició.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="SqlDialect (enum)&#10;H2 · POSTGRESQL" id="id-1f21f6070937418aba35da702651125f"/>
    <element xsi:type="archimate:DataObject" name="StoredEvent (record)" id="id-309d809aae994d7ebaaa721874c885c9"/>
    <element xsi:type="archimate:ApplicationComponent" name="AlertStore" id="id-702efab5896f42ec8946ef70119a92ce">
      <documentation>Tabla alert; una alerta por evento (UNIQUE; SQLState 23505 = ya existe).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AlertEngine" id="id-26c5fb0af3de4384b13da04179f0855f">
      <documentation>Lee los retiros nuevos, aplica las reglas y avisa a los oyentes.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AlertRules" id="id-91ff796c12724922a0a3ec01d499cd98">
      <documentation>RemovalKind → tipo y severidad de la alerta.</documentation>
    </element>
