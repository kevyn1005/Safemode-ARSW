      <documentation>WebSocket :8090 (Java-WebSocket): snapshot, alert y update; revisa Origin y sesión.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="NotificationService" id="id-103926b482bb438f87c0dcfb44389d4c">
      <documentation>Avisos de texto en hilos aparte; solo severidad alta y media.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GatewayRunner" id="id-1a2d627ba6d74291b582ad2805f9507b">
      <documentation>Arma y arranca todo el gateway a partir de las variables de entorno.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="DashboardHttpServer" id="id-30c6def93b5e455384867ef0090a6501">
      <documentation>HTTP :8080: página, fotos, /report, /cameras, /tracker/*, /puesto, /auth/*. 32 hilos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AuthService" id="id-27f1af6218594f64ad028b8d0d125b79">
      <documentation>Verifica el ID token de Google, lista blanca de correos y sesiones de 12 h.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="TrackerControl" id="id-99ff975189424585af7cae9b8beba4dc">
      <documentation>Estado, inicio y parada del tracker.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="TrackerProcess" id="id-06c0aedcb75248608a1d78da4f3910d6"/>
    <element xsi:type="archimate:ApplicationInterface" name="TokenVerifier" id="id-40b502ab08e747fa905f09605b973358">
