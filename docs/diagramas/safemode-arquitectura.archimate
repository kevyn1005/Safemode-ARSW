    <element xsi:type="archimate:ApplicationComponent" name="Correo (SMTP) · externo" id="id-e8f2ef9db64143ee91e57a37ff7c5159"/>
    <element xsi:type="archimate:DataObject" name="Usuarios y canales de aviso" id="id-7fceff6b13c24f94bf7eba25a1d5faff"/>
    <element xsi:type="archimate:DataObject" name="Alerta (fotos, fecha, hora, cámara)" id="id-e7d8d364e6d64c99b7145555228f7b05"/>
    <element xsi:type="archimate:DataObject" name="Cámaras y zonas (nombre, zona)" id="id-5134af8757ee4916aee2d744133efd71"/>
      <element xsi:type="archimate:ApplicationComponent" name="Servicio de visión de NVIDIA · externo, opcional" id="id-5b6c5a1dd1ae4ef882ad95d94af8dfe2">
      <documentation>Describe a la persona y sus tatuajes a partir de un recorte. Solo si hay clave (NVIDIA_API_KEY); el recorte con la cara sale a un tercero: decisión de privacidad del equipo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="GitHub Actions (CI/CD)" id="id-b02f111ea89a4ed59f0e423534a18ef0">
      <documentation>pipeline.yml: backend (mvn verify), frontend (c8), quality (Sonar) y deploy por SSH a la EC2. Los tres primeros son reusable workflows.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="SonarCloud / SonarQube · análisis estático" id="id-56f9449d8b2249689361e3ae2e812ddf"/>
    <element xsi:type="archimate:ApplicationComponent" name="SafeMode · sistema de alertas de objetos retirados" id="id-f7fd8b14a208460bbedf5635e1bc2c21">
      <documentation>Detecta mochilas, bolsos y maletas dejados sin vigilancia, registra quién es el dueño probable y quién los retira, y avisa en tiempo real al personal de seguridad.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Object Presence Tracker" id="id-c53714b43b1547089a07904f028e7fe0">
      <documentation>Seguimiento de objetos y personas por cámara: objeto quieto 3 s, dueño probable, retiro y su tipo (RemovalKind). Un seguimiento por cámara.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Servidor HTTP del panel (:8080)" id="id-9fac400e5ee04bf69f41d3fe53b2e933">
      <documentation>DashboardHttpServer: página, fotos por nombre, /report, /cameras, /tracker/*, /puesto, /auth/*. Pool de 32 hilos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Servidor WebSocket de alertas (:8090)" id="id-c5ed403fe54b47d98c57dace8f7e0a7e">
      <documentation>AlertGateway: snapshot al conectar y alerta/actualización en vivo; exige sesión y Origin del panel.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Autenticación y sesiones" id="id-5eadabe1501743579dd702899f3a8a7a">
      <documentation>AuthService: verifica el ID token de Google, lista blanca de correos, cookie safemode_session de 12 h; SessionStore en memoria o en la base (compartida entre réplicas).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Control del tracker" id="id-309c92d4171f4482b95b032692cfb453">
      <documentation>TrackerControl/TrackerProcess: inicia y detiene el tracker con un comando fijo (nada del navegador entra).</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Eventos de presencia&#10;(object_presence_event)" id="id-aa2df300e04342dca3e963048cd68893"/>
    <element xsi:type="archimate:DataObject" name="Alertas&#10;(alert)" id="id-f049ff1a1d534a1e86fd3feb722cec84"/>
    <element xsi:type="archimate:DataObject" name="Fotos PNG&#10;(data/frames)" id="id-ab114dd65e4a4887a005bae83d38efdf"/>
    <element xsi:type="archimate:ApplicationComponent" name="Tracker (proceso aparte)" id="id-6e5d8c6301464a2bae02d295856716f3">
      <documentation>Lo lanza el gateway (botón Iniciar vigilancia) o corre como contenedor en el despliegue público.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="PuestoApi · CollaborationClient" id="id-f6a0eabba7a64764bb0a1891aa9f9e95">
      <documentation>Intermediario del gateway hacia collaboration-service (zonas, historial y presencia), con la sesión del operador.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="OperatorDirectory · AccessDirectory" id="id-f46da380e73042ddb7befd928c233118">
      <documentation>Alta idempotente del operador en access-service (POST /operators/provision) y consulta de su permiso.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="collaboration-service" id="id-87b7b2665cc34113b95d412773ff0a94">
      <documentation>Configuración compartida del puesto (MongoDB, con versión), presencia y caché de permisos (Redis).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="CollaborationApi (HTTP)" id="id-dcd9ba014baa4331b98e35516137a4be"/>
    <element xsi:type="archimate:ApplicationComponent" name="PuestoStore&#10;(documento + versión)" id="id-b8a4f45804654abcba5e80e2a8c3ed90"/>
    <element xsi:type="archimate:ApplicationComponent" name="HistoryStore&#10;(historial, 90 días)" id="id-9f517afaa24d498aa684d147cc8bf92e"/>
    <element xsi:type="archimate:ApplicationComponent" name="RedisPresenceStore&#10;(presencia 20 s, caché 60 s)" id="id-ac55961a49cf477f9d0c08a454747b78"/>
