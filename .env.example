# Configuracion de Safemode para Docker Compose. Copie este archivo como `.env` (PowerShell: Copy-Item .env.example .env) y
# complete los valores. `.env` esta en .gitignore: NO lo suba con claves reales.
#
# Arranque (desde la raiz del repo):
#   docker compose -f docker-compose.yml -f docker-compose.persistencia.yml up -d --build --wait --wait-timeout 300 #       postgres mongo redis access-service collaboration-service console blackbox prometheus grafana realtime-gateway
# El proyecto se llama `safemode-arsw` (fijo en docker-compose.yml): sus contenedores, volumenes y red no se mezclan con los de
# ningun otro stack.

# ---- Inicio de sesion con Google (ADR 0004). OBLIGATORIAS: sin ellas el gateway no arranca ---------------------------------
# ID de cliente de OAuth de Google (no es secreto) y correos autorizados a entrar al panel, separados por comas.
SAFEMODE_GOOGLE_CLIENT_ID=
SAFEMODE_ALLOWED_EMAILS=
# Correos (subconjunto de los anteriores) que pueden CONFIGURAR el puesto (zonas, titulo) la primera vez que entran; los demas
# autorizados solo lo ven. Despues manda la base de datos: revocar a alguien se hace en PostgreSQL y no se deshace al reiniciar.
SAFEMODE_ADMIN_EMAILS=

# ---- Base de datos y paneles. Cambie las claves en un despliegue real --------------------------------------------------------
# OJO: POSTGRES_PASSWORD solo se aplica al CREAR el volumen de PostgreSQL; cambiarla despues no cambia la clave guardada.
POSTGRES_PASSWORD=lab-postgres
GRAFANA_PASSWORD=lab-grafana
LAB_ADMIN_KEY=lab-admin

# ---- Puertos publicados en el computador (siempre solo en 127.0.0.1) -------------------------------------------------------
# El panel (8080) y el WebSocket (8090) los fija el gateway y no se cambian desde aqui.
POSTGRES_PORT=5433
CONSOLE_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Comportamiento de los servicios de persistencia -----------------------------------------------------------------------
# solucion (por defecto) | base (los defectos del punto de partida, para repetir la medicion del "antes", ADR 0005)
DECISIONS_MODE=solucion
